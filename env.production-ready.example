# Browser (safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PLATFORM_MODE=demo
VITE_DEFAULT_LOCALE=de

# Server only — set as backend secrets, never in browser code
PROVIDER_MODE=mock                # mock | live

# Swan banking adapter
SWAN_API_URL=
SWAN_CLIENT_ID=
SWAN_CLIENT_SECRET=
SWAN_WEBHOOK_SECRET=

# Adyen acquiring adapter
ADYEN_API_URL=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=                   # hex-encoded, used for notification HMAC

# Zoryn Rewards Hub (optional — rewards work locally without it)
REWARDS_HUB_URL=
REWARDS_INGEST_SECRET=
REWARDS_TENANT_SLUG=zoryn

# Fallback webhook signature secret for mock/self-signed events
PROVIDER_WEBHOOK_SECRET=

# --- Stage 1-3 workers -------------------------------------------------------
# Secret required by the background worker endpoints. The project jobs secret
# is accepted as a fallback so existing cron entries keep working.
PROVIDER_WORKER_SECRET=
NOTIFICATION_WORKER_SECRET=

# mock (default, self-contained demo) | sandbox | live
PROVIDER_MODE=mock
# mock (default, no-op delivery) | live
NOTIFICATION_MODE=mock

# Only needed when PROVIDER_MODE is sandbox or live.
SWAN_API_URL=
SWAN_ACCESS_TOKEN=
ADYEN_API_URL=
ADYEN_API_KEY=
REWARDS_API_URL=
REWARDS_SERVICE_TOKEN=
